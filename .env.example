# ==============================================================
# M_Dalats Boutique Villa - Environment Configuration Example
# Copy this file to `.env` and fill in your secrets and domain.
# ==============================================================

# --------------------------------------------------------------
# 1. Docker Compose & Deployment Settings
# --------------------------------------------------------------
DOCKER_IMAGE=tuananhcoder1/dalats:latest
HTTP_PORT=80
APP_PORT=3000

# --------------------------------------------------------------
# 2. Better Auth & Security
# --------------------------------------------------------------
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=K2WBz3+c7ZM2B4sSxvu5EPXAH9tx60Y25QEAAoFGBv4=
# Public domain of the website (e.g. https://dalatsvilla.duckdns.org or http://localhost:3000)
BETTER_AUTH_URL=https://dalatsvilla.duckdns.org
# Comma-separated list of trusted origins for auth API & CORS
BETTER_AUTH_TRUSTED_ORIGINS=https://dalatsvilla.duckdns.org,http://localhost:3000,http://localhost

# Optional: GitHub Social OAuth
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=

# --------------------------------------------------------------
# 3. PostgreSQL Database
# --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=mdalats_villa
POSTGRES_PORT=5432
# In Docker network, host is 'postgres'. For local host dev, use 'localhost'.
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/mdalats_villa

# --------------------------------------------------------------
# 4. Redis In-Memory Cache
# --------------------------------------------------------------
REDIS_PASSWORD=redispassword
REDIS_PORT=6379
# In Docker network, host is 'redis'. For local host dev, use 'localhost'.
REDIS_URL=redis://:redispassword@redis:6379

# --------------------------------------------------------------
# 5. MinIO / Silo S3 Media Storage
# --------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_SERVER_URL=http://localhost:9000

# S3 Client Configuration inside Next.js
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword123
S3_BUCKET=mdalats-media
# In production with Nginx reverse proxy, media streams through /media/
S3_PUBLIC_URL=https://dalatsvilla.duckdns.org/media
S3_FORCE_PATH_STYLE=true
